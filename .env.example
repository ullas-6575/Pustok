# Copy only when .env does not already exist. Use unquoted values.
DB_URL=jdbc:postgresql://aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=CHANGE_ME
PORT=8081

# Generate a random Base64-encoded 32-byte secret; never commit the real value.
JWT_SECRET=REPLACE_WITH_RANDOM_BASE64_SECRET
JWT_COOKIE_SECURE=false

# One-time admin creation: use a NEW email and a strong password (12+ characters).
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
